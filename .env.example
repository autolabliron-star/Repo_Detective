# ---- The only required setup: an OpenAI-compatible LLM endpoint ----------------
# Any provider works (OpenAI, Anthropic, Azure, Groq, a local model...) by changing
# these three values — no vendor or model is hardcoded anywhere.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# ---- Optional -------------------------------------------------------------------
# GitHub allows 60 anonymous API requests per hour; one investigation uses ~40.
# A free personal token (no scopes needed) raises that to 5,000/hour — recommended
# when running several repositories back to back.
GITHUB_TOKEN=

# LLM calls per investigation — the assignment's hard budget.
DETECTIVE_BUDGET=30

# Reasoning models only (gpt-5.x, o-series): how hard to think per call (none/low/medium/high).
# Safe to leave empty on any model: the client drops the parameter if the provider rejects it,
# and OpenAI's chat/completions endpoint requires "none" for tool calls — the client learns
# that from the first response and carries on.
OPENAI_REASONING_EFFORT=
