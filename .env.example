# --- LLM (required) — any OpenAI-compatible provider ---
OPENAI_API_KEY=sk-your-key-here
# Base URL of your provider's OpenAI-compatible endpoint (include /v1 where the provider requires it).
# OpenAI:      https://api.openai.com/v1   (or leave unset)
# Anthropic:   https://api.anthropic.com/v1
# Azure/local: your deployment's endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Any model your provider serves, e.g. gpt-4.1, claude-sonnet-5, llama3.1:70b
OPENAI_MODEL=gpt-4.1

# --- Optional ---
# GitHub token raises the API rate limit from 60/h (anonymous) to 5000/h. NOT required.
# GITHUB_TOKEN=ghp_...
# Override the per-investigation LLM call budget (default 30).
# DETECTIVE_BUDGET=30
