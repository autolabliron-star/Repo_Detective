# ---- The only required setup: an OpenAI-compatible LLM endpoint ----------------
# Three values, any provider — no vendor or model is hardcoded anywhere. Pick a row:
#
#   OpenAI      OPENAI_BASE_URL=https://api.openai.com/v1
#               OPENAI_MODEL=<any OpenAI model with tool calling>
#   Anthropic   OPENAI_BASE_URL=https://api.anthropic.com/v1
#               OPENAI_MODEL=claude-sonnet-5        (any Claude model id)
#   Azure       OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#               OPENAI_MODEL=<your deployment name>
#   Local       OPENAI_BASE_URL=http://host.docker.internal:11434/v1   (Ollama; vLLM/LM Studio: their port)
#               OPENAI_MODEL=<a tool-calling model you serve>; OPENAI_API_KEY can be any non-empty string
#
# The client adapts at runtime to what the endpoint accepts (temperature, token-cap name,
# forced tool choice, reasoning effort), so switching rows is configuration, not code.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# ---- Optional -------------------------------------------------------------------
# GitHub allows 60 anonymous API requests per hour; one investigation uses 25-45.
# A free personal token (no scopes needed) raises that to 5,000/hour — needed to run
# all three test repositories within one hour.
GITHUB_TOKEN=

# LLM calls per investigation — the assignment's hard budget.
DETECTIVE_BUDGET=30

# Reasoning models only (gpt-5.x, o-series): how hard to think per call (none/low/medium/high).
# Safe to leave empty on any model: the client drops the parameter if the provider rejects it,
# and OpenAI's chat/completions endpoint requires "none" for tool calls — the client learns
# that from the first response and carries on.
OPENAI_REASONING_EFFORT=
